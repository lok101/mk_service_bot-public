# Public mirror placeholder env. Not a full private ops template.
# Copy to .env.dev for local experiments; keep secrets out of git.

ENVIRONMENT=dev
API_HOST=127.0.0.1
API_PORT=8000

# Optional. Empty = in-memory stores for local runs.
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=mk_service_bot_dev

BOT_TOKEN=
TELEGRAM_WEBHOOK_IP=
TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=

GOOGLE_FORMS_WEBHOOK_SECRET=
REVISION_FORM_TOKEN_SECRET=
LOADING_FORM_TOKEN_SECRET=

PHOTO_STORAGE_BACKEND=memory

# Leave unset in public experiments unless you intentionally wire sandbox creds.
MOYSKLAD_API_TOKEN=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
